generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum InventoryMovementType {
  PURCHASE
  EXIT
  CONSUMPTION
  ADJUSTMENT
  RETURN
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum UserRole {
  ADMIN
  GERENTE
  VENTAS
  ALMACEN
  COMPRAS
  PRODUCCION
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VENTAS)
  createdInventoryMovements InventoryMovement[] @relation("MovementCreatedBy")
  updatedInventoryMovements InventoryMovement[] @relation("MovementUpdatedBy")
  auditLogs                 AuditLog[]
  purchaseReceipts          PurchaseReceipt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RolePermission {
  role   UserRole
  module String
  action PermissionAction

  @@id([role, module, action])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model Supplier {
  id        String         @id @default(uuid())
  name      String
  email     String?
  phone     String?
  companyName String?
  notes     String?
  isActive  Boolean        @default(true)
  orders    PurchaseOrder[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
}

model Client {
  id          String    @id @default(uuid())
  name        String
  email       String?   @unique
  phone       String?
  companyName String?
  notes       String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name, id])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  estimatedRevenue Decimal  @default(0) @db.Decimal(14, 2)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productionOrders ProductionOrder[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([createdAt, id])
}

model Material {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  unit               String
  unitCost           Decimal             @db.Decimal(12, 2)
  minimumStock       Decimal             @default(0) @db.Decimal(14, 2)
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([name, id])
}

model PurchaseOrder {
  id          String                @id @default(uuid())
  supplierId  String
  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status      PurchaseOrderStatus   @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  items       PurchaseOrderItem[]
  receipts    PurchaseReceipt[]
  movements   InventoryMovement[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([supplierId])
  @@index([status, createdAt])
  @@index([createdAt, id])
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity          Decimal       @db.Decimal(14, 2)
  receivedQuantity  Decimal       @default(0) @db.Decimal(14, 2)
  unitCost          Decimal       @db.Decimal(12, 2)
  receiptItems      PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

model PurchaseReceipt {
  id               String                 @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedById     String?
  receivedBy       User?                   @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  reference        String?
  notes            String?
  items            PurchaseReceiptItem[]
  createdAt        DateTime                @default(now())

  @@index([purchaseOrderId, createdAt])
}

model PurchaseReceiptItem {
  id                    String             @id @default(uuid())
  receiptId             String
  receipt               PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId   String
  purchaseOrderItem     PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantity              Decimal            @db.Decimal(14, 2)
  unitCost              Decimal            @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([purchaseOrderItemId])
}

model ProductionOrder {
  id          String               @id @default(uuid())
  name        String
  description String?
  status      ProductionOrderStatus @default(PLANNED)
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  movements   InventoryMovement[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
  @@index([createdAt, id])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  eventUuid    String                @unique
  materialId   String
  material     Material              @relation(fields: [materialId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?                 @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?                 @relation("MovementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  movementType InventoryMovementType
  quantity     Decimal               @db.Decimal(14, 2)
  unitCost     Decimal?              @db.Decimal(12, 2)
  reference    String?
  notes        String?
  createdAt    DateTime              @default(now())

  @@index([materialId])
  @@index([createdAt, id])
  @@index([productionOrderId])
  @@index([createdById])
  @@index([updatedById])
}
