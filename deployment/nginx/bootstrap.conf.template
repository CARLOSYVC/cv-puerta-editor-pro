server {
    listen 80;
    server_name ${APP_DOMAIN} ${API_DOMAIN} ${STAGING_APP_DOMAIN} ${STAGING_API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 503 "TLS certificate is not provisioned yet\n";
        add_header Content-Type text/plain;
    }
}
